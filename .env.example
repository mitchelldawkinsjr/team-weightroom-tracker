# =============================================
# team-weightroom-tracker — environment config
# Copy this file to .env and fill in values.
# =============================================

# --- Required for production ---
# Strong random secret for signing JWTs (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-use-openssl-rand-hex-32

# Coach PIN validated server-side on coach registration (default: COACH2025)
COACH_PIN=COACH2025

# --- Optional: change Postgres password (default: postgres) ---
POSTGRES_PASSWORD=postgres

# --- Optional: host port the app listens on (default: 3020) ---
# Used by docker-compose to bind the container to a host port.
# Set to any free port on your VPS; NPM uses weightroom-app:3000 on 360ws-network.
PORT=3020

# --- Optional: override coach PIN in client UI at build time (must match COACH_PIN) ---
# docker compose build --build-arg VITE_COACH_PIN=yourpin
# VITE_COACH_PIN=your_secret_pin

# --- Local dev only (not used by Docker) ---
# VITE_API_BASE=http://127.0.0.1:3020
